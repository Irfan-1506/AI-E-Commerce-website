DATABASE_URL="postgresql://commerce:commerce_dev_only@localhost:5432/ai_commerce"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"   # leave unset to skip the durable event bus — see events.service.ts

JWT_ACCESS_SECRET="change-me-generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="change-me-different-secret"

WEB_ORIGIN="http://localhost:3000"
PORT=4000

# S3-compatible storage (works with AWS S3, MinIO, DigitalOcean Spaces)
S3_BUCKET="ai-commerce-products"
S3_REGION="us-east-1"
S3_ENDPOINT=""                  # leave blank for real AWS; set for MinIO/Spaces
S3_ACCESS_KEY="changeme"
S3_SECRET_KEY="changeme"
S3_PUBLIC_BASE_URL=""           # e.g. https://cdn.yourdomain.com

# SSLCommerz (Bangladesh payment gateway) — get sandbox credentials at
# https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID="changeme"
SSLCOMMERZ_STORE_PASSWORD="changeme"
SSLCOMMERZ_IS_LIVE="false"      # "true" only in production
APP_BASE_URL="http://localhost:4000"   # publicly reachable API URL — SSLCommerz calls back here

# AI features (Phase 5)
ANTHROPIC_API_KEY="changeme"    # https://console.anthropic.com
VOYAGE_API_KEY="changeme"       # https://dash.voyageai.com — used for product/query embeddings

# Observability (optional in dev — leave blank to disable)
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"

# CAPTCHA (Phase 6 hardening) — leave blank in dev; register/high-risk login
# skip CAPTCHA entirely when this isn't set, rather than blocking local dev
HCAPTCHA_SECRET=""              # https://dashboard.hcaptcha.com

# Secrets manager (optional) — if set, secrets are loaded from AWS Secrets
# Manager at boot and override any matching .env values. Leave unset to use
# plain env vars (the default for local dev and this scaffold as shipped).
AWS_SECRETS_ID=""
AWS_REGION="ap-southeast-1"

NODE_ENV=development
