# Used server-side by next.config.js's rewrite (proxies /api/* to the NestJS
# API so the browser only ever talks to one origin — see next.config.js for
# why that matters for cookie-based auth) and by generateMetadata/sitemap.ts.
API_ORIGIN="http://localhost:4000"

# Public site URL, used for canonical links, OpenGraph/Twitter card URLs,
# and the sitemap. Must be set correctly in production — defaults to
# localhost otherwise, which would ship broken canonical tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# CAPTCHA — leave blank in dev. Widgets simply don't render when unset,
# same fail-open-in-dev pattern as the backend's HCAPTCHA_SECRET.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""

# Frontend error tracking (Phase 6) — leave blank to disable Sentry entirely.
NEXT_PUBLIC_SENTRY_DSN=""
